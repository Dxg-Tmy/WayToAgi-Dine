# 顺点 · 本地代理配置（本文件不要提交到 Git！.gitignore 已排除）
# 复制本文件为 .env 并填入真实值

# 麦当劳 MCP Token（open.mcd.cn/mcp 手机号登录 → 控制台 → 激活申请）
MCD_MCP_TOKEN=

# 门店（二选一：填了 code 直接用；不填则启动时按城市+关键词自动选最近门店）
MCD_STORE_CODE=
MCD_STORE_NAME=

# 自动选店用的定位（city + keyword 都必须传，只传一个接口会报 600058）
MCD_CITY=重庆市
MCD_KEYWORD=麦当劳

# 服务端口
PORT=8787
